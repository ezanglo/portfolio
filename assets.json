{
  "version": 1,
  "name": "Ezra Anglo Portfolio",
  "publicDir": "public",
  "command": "npx open-assets render",
  "collections": [
    {
      "id": "favicon",
      "label": "Favicon",
      "sourceSize": { "width": 512, "height": 512 },
      "templates": [
        { "src": "assets/logo/favicon.svg", "name": "favicon", "label": "Favicon" }
      ],
      "export": [
        { "name": "256", "label": "256px", "size": { "width": 256, "height": 256 } },
        { "name": "48", "label": "48px", "size": { "width": 48, "height": 48 } },
        { "name": "32", "label": "32px", "size": { "width": 32, "height": 32 } },
        { "name": "16", "label": "16px", "size": { "width": 16, "height": 16 } }
      ]
    },
    {
      "id": "logo",
      "label": "Logo",
      "sourceSize": { "width": 512, "height": 512 },
      "templates": [
        { "src": "assets/logo/logo.svg", "name": "logo", "label": "Logo" }
      ],
      "export": [
        { "name": "1024", "label": "1024px", "size": { "width": 1024, "height": 1024 } },
        { "name": "180", "label": "180px (Apple touch)", "size": { "width": 180, "height": 180 } },
        { "name": "32", "label": "32px", "size": { "width": 32, "height": 32 } },
        { "type": "copy-source", "format": "svg" }
      ]
    }
  ]
}
